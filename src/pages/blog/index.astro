---
import { CardGrid } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import BetterCard from '../../components/BetterCard.astro';

let allPosts = await getCollection('blog');
allPosts = allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

function getReadingTime(text: string): string {
  const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}

function getAuthorNames(post: any): string {
  if (post.data.authors && post.data.authors.length > 0) {
    return post.data.authors.map((a: any) => (typeof a === 'string' ? a : a.name)).join(', ');
  }
  if (post.data.author) {
    return typeof post.data.author === 'string' ? post.data.author : post.data.author.name;
  }
  return 'Jaci Team';
}
---

<StarlightPage
  frontmatter={{ title: 'Blog', template: 'splash' }}
>
  <div class="blog-header">
    <p class="blog-intro">Engineering deep dives, runtime architecture breakdowns, performance benchmarks, and release updates from the Jaci team.</p>
  </div>

  <div class="blog-list">
      <CardGrid stagger={true}>
          {allPosts.map((post) => {
          const href = `${import.meta.env.BASE_URL}/blog/${post.id}`;
          const icon = post.data.title.toLowerCase().includes("recap") ? "document" : "star";
          const readingTime = getReadingTime(post.body || '');
          const authorNames = getAuthorNames(post);
          return (
          <BetterCard title={post.data.title} icon={icon} href={href}>
              {post.data.description && <p class="post-description">{post.data.description}</p>}
              <div class="post-meta">
                <span class="post-author">{authorNames}</span>
                <span class="meta-dot">·</span>
                <span class="post-date">{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
                <span class="meta-dot">·</span>
                <span class="post-reading-time">{readingTime}</span>
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => (
                    <span class="tag-badge">{tag}</span>
                  ))}
                </div>
              )}
          </BetterCard>
          )
          })}
      </CardGrid>
  </div>
</StarlightPage>

<style>
    .blog-header {
        margin-bottom: 2rem;
    }
    .blog-intro {
        font-size: 1.15rem;
        color: var(--sl-color-gray-2);
        line-height: 1.6;
        margin: 0;
    }
    .blog-list {
        margin: auto;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .post-description {
        color: var(--sl-color-gray-2);
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0.5rem 0 1rem 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--sl-color-gray-3);
    }
    .post-author {
        font-weight: 500;
        color: var(--sl-color-gray-1);
    }
    .meta-dot {
        color: var(--sl-color-gray-4);
    }
    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }
    .tag-badge {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        background-color: var(--sl-color-gray-6);
        color: var(--sl-color-gray-2);
        border: 1px solid var(--sl-color-gray-5);
    }

    :root {
        .blog-list .post-date {
            color: var(--sl-color-gray-2);
        }
    }

    :root[data-theme='light'] {
        .blog-list .post-date {
            color: var(--sl-color-gray-3);
        }
        .post-author {
            color: var(--sl-color-gray-5);
        }
    }
</style>
